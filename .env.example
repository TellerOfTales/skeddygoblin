# ---------------------------------------------------------------------------
# Discord
# ---------------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications  (KEEP SECRET)
DISCORD_TOKEN=
# Application ID, same page
DISCORD_CLIENT_ID=
# Stage 1 registers guild-scoped commands ONLY (instant propagation).
# Right-click your server > Copy Server ID. Boot refuses to start without it.
DISCORD_GUILD_ID=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://skeddy:skeddy@localhost:5432/skeddygoblin
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
# IANA zone used to seed a new group's timezone. All day/window buckets are
# interpreted in the GROUP's timezone, never the user's - see src/domain/week.ts.
DEFAULT_GROUP_TIMEZONE=UTC
# Optional bootstrap channel for the weekly prompt / leaderboard before /setup runs.
ANNOUNCE_CHANNEL_ID=
# Leave false in local dev so you don't DM yourself every tick.
SCHEDULER_ENABLED=false
TICK_INTERVAL_MS=60000
# Register guild commands automatically on boot (dev convenience).
AUTO_REGISTER_COMMANDS=true

# ---------------------------------------------------------------------------
# Stage 2 (Steam) - unused until step 7
# ---------------------------------------------------------------------------
STEAM_API_KEY=
# Public base URL for the Steam OpenID return_to callback, e.g. https://bot.example.com
# Steam features stay completely off unless BOTH of these are set.
PUBLIC_BASE_URL=
# Port the Steam callback server listens on (only started when Steam is configured).
HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Tests only
# ---------------------------------------------------------------------------
DATABASE_URL_TEST=postgres://skeddy:skeddy@localhost:5432/skeddygoblin_test

# Landing page carrying the terms and privacy policy Discord verification needs.
WEBSITE_URL=https://connectioneering.design/skeddy-goblin
# Install link. Derived from DISCORD_CLIENT_ID when unset, so this is optional.
INVITE_URL=
